; ==============================================================================
; Verdi Signal List & Waveform Layout for Single-IP PWM SoC UVM Integration
; Project: RISC-V Smart Control SoC - Honours Project
; Target : Real DUT (soc_top) + PWM VIP Interface
; ==============================================================================

; --- GROUP 1: CLOCK AND RESET ---
addGroup "GROUP 1: CLOCK AND RESET"
addSignal -h 15 /tb_soc_pwm/clk
addSignal -h 15 /tb_soc_pwm/rst_n

; --- GROUP 2: PWM OUTPUT (DUT vs INTERFACE vs VIP MONITOR) ---
addGroup "GROUP 2: PWM OUTPUT (DUT vs INTERFACE vs VIP MONITOR)"
addSignal -h 15 /tb_soc_pwm/dut_pwm_out
addSignal -h 15 /tb_soc_pwm/interface_pwm_out
addSignal -h 15 /tb_soc_pwm/uvm_vip_monitor_pwm_out

; --- GROUP 3: PWM INTERNAL REGISTERS & COUNTER ---
addGroup "GROUP 3: PWM INTERNAL REGISTERS & COUNTER"
addSignal -h 15 /tb_soc_pwm/internal_pwm_en
addSignal -h 15 -UDEC /tb_soc_pwm/internal_pwm_period[31:0]
addSignal -h 15 -UDEC /tb_soc_pwm/internal_pwm_duty[31:0]
addSignal -h 15 -UDEC /tb_soc_pwm/internal_pwm_count[31:0]

; --- GROUP 4: RISC-V CPU EXECUTION ---
addGroup "GROUP 4: RISC-V CPU"
addSignal -h 15 -HEX /tb_soc_pwm/dut/trace_rv_i_address_ip[31:0]
addSignal -h 15 -HEX /tb_soc_pwm/dut/trace_rv_i_insn_ip[31:0]
addSignal -h 15 /tb_soc_pwm/dut/trace_rv_i_valid_ip
