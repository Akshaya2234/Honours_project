; ==============================================================================
; Verdi Signal Layout for C Firmware Hello World UART Test
; Testbench: tb_soc_c_hello
; Hierarchy: tb_soc_c_hello.dut (soc_top)
;            tb_soc_c_hello.dut.u_interconnect_uart (axi_interconnect_uart_top)
;            tb_soc_c_hello.dut.u_interconnect_uart.u_axi_uart (axi_uart_top)
; ==============================================================================

; --- Group 1: Clocks & Reset ---
addGroup "1. Clocks and Reset"
addSignal -h 15 /tb_soc_c_hello/clk
addSignal -h 15 /tb_soc_c_hello/clk_vga
addSignal -h 15 /tb_soc_c_hello/rst_n

; --- Group 2: UART Physical TX/RX Pin (KEY OUTPUT) ---
addGroup "2. UART Serial Interface (CPU Output)"
addSignal -h 25 /tb_soc_c_hello/uart_tx
addSignal -h 25 /tb_soc_c_hello/uart_rx
addSignal -h 15 /tb_soc_c_hello/uart_irq

; --- Group 3: UART Internal Registers (inside axi_uart_top) ---
addGroup "3. UART Internal State"
addSignal -h 15 -HEX /tb_soc_c_hello/dut/u_interconnect_uart/u_axi_uart/uart_baudrate_div_int[15:0]
addSignal -h 15 -HEX /tb_soc_c_hello/dut/u_interconnect_uart/u_axi_uart/uart_config_reg_int[31:0]
addSignal -h 15 -HEX /tb_soc_c_hello/dut/u_interconnect_uart/u_axi_uart/uart_lsr_reg_int[31:0]
addSignal -h 15 /tb_soc_c_hello/dut/u_interconnect_uart/u_axi_uart/tx_fifo_full_int
addSignal -h 15 -HEX /tb_soc_c_hello/dut/u_interconnect_uart/u_axi_uart/data_tx_fifo_controller[7:0]
addSignal -h 15 -HEX /tb_soc_c_hello/dut/u_interconnect_uart/u_axi_uart/data_rx_controller_fifo[7:0]

; --- Group 4: CPU LSU Write Channel (CPU writing to UART THR) ---
addGroup "4. CPU LSU -> AXI Write (UART Register Writes)"
addSignal -h 15 -HEX /tb_soc_c_hello/dut/lsu_axi_awaddr[31:0]
addSignal -h 15 /tb_soc_c_hello/dut/lsu_axi_awvalid
addSignal -h 15 /tb_soc_c_hello/dut/lsu_axi_awready
addSignal -h 15 -HEX /tb_soc_c_hello/dut/lsu_axi_wdata[63:0]
addSignal -h 15 /tb_soc_c_hello/dut/lsu_axi_wvalid
addSignal -h 15 /tb_soc_c_hello/dut/lsu_axi_wready
addSignal -h 15 /tb_soc_c_hello/dut/lsu_axi_bvalid
addSignal -h 15 /tb_soc_c_hello/dut/lsu_axi_bready

; --- Group 5: CPU LSU Read Channel (CPU reading UART LSR) ---
addGroup "5. CPU LSU -> AXI Read (UART Status Reads)"
addSignal -h 15 -HEX /tb_soc_c_hello/dut/lsu_axi_araddr[31:0]
addSignal -h 15 /tb_soc_c_hello/dut/lsu_axi_arvalid
addSignal -h 15 /tb_soc_c_hello/dut/lsu_axi_arready
addSignal -h 15 -HEX /tb_soc_c_hello/dut/lsu_axi_rdata[63:0]
addSignal -h 15 /tb_soc_c_hello/dut/lsu_axi_rvalid
addSignal -h 15 /tb_soc_c_hello/dut/lsu_axi_rready

; --- Group 6: CPU IFU Instruction Fetch ---
addGroup "6. CPU IFU - Instruction Fetch (IMEM Read)"
addSignal -h 15 -HEX /tb_soc_c_hello/dut/ifu_axi_araddr[31:0]
addSignal -h 15 /tb_soc_c_hello/dut/ifu_axi_arvalid
addSignal -h 15 /tb_soc_c_hello/dut/ifu_axi_arready
addSignal -h 15 -HEX /tb_soc_c_hello/dut/ifu_axi_rdata[63:0]
addSignal -h 15 /tb_soc_c_hello/dut/ifu_axi_rvalid
addSignal -h 15 /tb_soc_c_hello/dut/ifu_axi_rready

; --- Group 7: CPU Instruction Trace (Retired Instructions) ---
addGroup "7. CPU Trace - Instruction Retirement"
addSignal -h 15 -HEX /tb_soc_c_hello/dut/trace_rv_i_address_ip[31:0]
addSignal -h 15 -HEX /tb_soc_c_hello/dut/trace_rv_i_insn_ip[31:0]
addSignal -h 15 /tb_soc_c_hello/dut/trace_rv_i_valid_ip
addSignal -h 15 /tb_soc_c_hello/dut/trace_rv_i_exception_ip
addSignal -h 15 -HEX /tb_soc_c_hello/dut/trace_rv_i_ecause_ip[4:0]

; --- Group 8: GPIO & Watchdog Status ---
addGroup "8. GPIO and Watchdog"
addSignal -h 15 -HEX /tb_soc_c_hello/dut/gpio_out[7:0]
addSignal -h 15 /tb_soc_c_hello/dut/wdt_reset_out
addSignal -h 15 /tb_soc_c_hello/dut/pwm_out
